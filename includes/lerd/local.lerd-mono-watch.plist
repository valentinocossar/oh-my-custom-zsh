<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.lerd-mono-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.oh-my-custom-zsh/includes/lerd/lerd-mono.sh</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>__HOME__/Library/LaunchAgents/lerd-tray.plist</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/lerd-mono-watch.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/lerd-mono-watch.log</string>
</dict>
</plist>
